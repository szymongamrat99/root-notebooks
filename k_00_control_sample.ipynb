    "import ROOT\n",
    "\n",
    "# Flaga sterujÄ…ca: True -> odejmij tÅ‚o !has00 od Danych i bierz tylko has00 dla MC\n",
    "SUBTRACT_NON_00 = False\n",
    "\n",
    "basic_hist = {}\n",
    "modes = {\n",
    "    \"full\": [\n",
    "        [501, 0, 1000],\n",
    "        [501, 280, 600],\n",
    "        [501, 0, 350]\n",
    "    ],\n",
    "    \"zoom\": [\n",
