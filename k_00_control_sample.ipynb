   "outputs": [],
   "source": [
    "tag_condition = \"!(rho_ch < 4.0 && abs(z_ch) < 2.0) && (abs(Qmiss - 116.5) < 170.0)\"\n",
    "\n",
    "cut_values = [rms * float(val) for val in np.arange(0, 50.0, 2.0)]\n",
    "\n",
    "pm_counts = []\n",
    "nonpm_counts = []\n",
    "\n",
    "for val in cut_values:\n",
    "    condition = f\"{optimized_variable} > {val}\"\n",
    "\n",
    "    pm_counts.append(df_CS_tag[\"Semileptonic\"].Filter(f\"{condition} && {tag_condition}\").Count())\n",
    "    nonpm_counts.append(df_CS_tag[\"nonSemileptonic\"].Filter(f\"{condition} && {tag_condition}\").Count())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "38c820bb-bb8a-46f8-b1ef-78f6bc67e41f",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "1"
      ]
     },
     "execution_count": 13,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "all_counts = pm_counts + nonpm_counts\n",
    "\n",
    "ROOT.RDF.RunGraphs(all_counts)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "1c587c64-6f4a-4860-86bc-95de0bcf91ba",
   "metadata": {},
   "outputs": [],
   "source": [
    "pm_counts = [val.GetValue() for val in pm_counts]\n",
    "nonpm_counts = [val.GetValue() for val in nonpm_counts]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "d450e20b-d54d-48f0-a289-0b2d0339b67b",
   "metadata": {},
   "outputs": [],
   "source": [
    "purity = []\n",
    "significance = []\n",
    "efficiency = {\"Semileptonic\": [], \"nonSemileptonic\": []}\n",
    "\n",
    "for nonpm, pm in zip(nonpm_counts, pm_counts):\n",
    "    purity.append(pm / (nonpm + pm) if (nonpm + pm) > 0 else 0.99)\n",
    "    significance.append(pm / np.sqrt(nonpm + pm) if (nonpm + pm) > 0 else 0.0)\n",
    "    efficiency[\"Semileptonic\"].append(pm / total_counts[\"Semileptonic\"]) \n",
    "    efficiency[\"nonSemileptonic\"].append(nonpm / total_counts[\"nonSemileptonic\"]) "
   ]
  },
