{ "cells": [  {   "cell_type": "code",   "execution_count": 44,   "id": "60988920-44be-43c4-a596-91a715384302",   "metadata": {},   "outputs": [],   "source": [    "import glob\n",    "import math\n",    "import numpy as np\n",    "import concurrent.futures\n",    "\n",    "import ROOT\n",    "from utils.hist_utils import get_highest_channels, fit_and_scale_mc\n",    "\n",    "ROOT.EnableImplicitMT()\n",    "ROOT.gStyle.SetPalette(ROOT.kRainbow)\n",    "\n",    "ROOT.gSystem.Load(\"/workspace/KLOE/Include/Codes/libLibRec.so\")\n",    "ROOT.gInterpreter.AddIncludePath(\"/workspace/KLOE/Include/Codes/\")\n",    "\n",    "ROOT.gInterpreter.Declare('#include \"const.h\"')\n",    "\n",    "ROOT.KLOE.setGlobalStyle()\n",    "\n",    "channName = {int(k): str(v) for k, v in ROOT.KLOE.channName}\n",    "channTitle = {str(k): str(v) for k, v in ROOT.KLOE.channTitle}\n",    "channColor = {str(k): int(v) for k, v in ROOT.KLOE.channColor}"   ]  },  {   "cell_type": "code",   "execution_count": 45,   "id": "2437dc4a-1b7e-4747-be2d-875eae0f3c04",   "metadata": {},   "outputs": [    {     "name": "stdout",     "output_type": "stream",     "text": [      "Przetestowano 181 plików. Poprawnych: 180, Odrzuconych: 1\n",      "Przetestowano 105 plików. Poprawnych: 105, Odrzuconych: 0\n",      "Lumi factor: 0.5479\n"     ]    }   ],   "source": [    "\n",    "# Pobierz wszystkie pliki pasujące do wzorca\n",    "all_files = glob.glob(\n",    "    \"/workspace/root_files/kitt/ALL_PHYS_THREE_PI0_NoSmearing/*.root\"\n",    ")\n",    "all_files += glob.glob(\n",    "    \"/workspace/root_files/kitt/ALL_PHYS2_THREE_PI0_NoSmearing/*.root\"\n",    ")\n",    "all_files += glob.glob(\n",    "    \"/workspace/root_files/kitt/ALL_PHYS3_THREE_PI0_NoSmearing/*.root\"\n",    ")\n",    "\n",    "data_files = []\n",    "\n",    "for i in range(1, 106, 1):\n",    "    data_files += glob.glob(\n",    "        f\"/workspace/root_files/hal/DATA_THREE_PI0_NoSmearing/dk0*_{i}.root\"\n",    "    )\n",    "\n",    "def check_single_file(f):\n",    "    \"\"\"Sprawdza pojedynczy plik na osobnym wątku.\"\"\"\n",    "    try:\n",    "        # kError ignoruje niepotrzebne ostrzeżenia w konsoli\n",    "        ROOT.gErrorIgnoreLevel = ROOT.kError\n",    "        tf = ROOT.TFile.Open(f, \"READ\")\n",    "        if tf and not tf.IsZombie():\n",    "            tree = tf.Get(\"h1\")\n",    "            if tree and not tree.IsZombie():\n",    "                tf.Close()\n",    "                return f\n",    "        if tf:\n",    "            tf.Close()\n",    "    except Exception:\n",    "        pass\n",    "    return None\n",    "\n",    "\n",    "def get_valid_files_fast(file_list):\n",    "    \"\"\"Sprawdza całą listę plików równolegle na wielu rdzeniach CPU.\"\"\"\n",    "    with concurrent.futures.ThreadPoolExecutor(max_workers=64) as executor:\n",    "        results = list(executor.map(check_single_file, file_list))\n",    "    # Zwraca tylko poprawne pliki\n",    "    valid = [f for f in results if f is not None]\n",    "    print(\n",    "        f\"Przetestowano {len(file_list)} plików. Poprawnych: {len(valid)}, Odrzuconych: {len(file_list) - len(valid)}\"\n",    "    )\n",    "    return valid\n",    "\n",    "\n",    "# Użycie (błyskawiczne!):\n",    "all_files = get_valid_files_fast(all_files)\n",    "data_files = get_valid_files_fast(data_files)\n",    "\n",    "# Scaling factor\n",    "lumi_data = 408608.49375\n",    "lumi_mc = 745800.1127\n",    "scaling_factor = lumi_data / lumi_mc\n",    "print(f\"Lumi factor: {scaling_factor:.4f}\")\n",    "\n",    "# Przekaż czystą listę plików bezpośrednio do RDataFrame\n",    "df = ROOT.RDataFrame(\"h1\", all_files)\n",    "df_data = ROOT.RDataFrame(\"h1\", data_files)\n",    "df_3pi0 = df.Filter(\"mcflag == 1 && (mctruth == 4 || mctruth == 0 || mctruth == -1)\")\n",    "df_data = (df_data\n",    "    .Define(\"Kchrec_5\", \"Kchrec[5]\")\n",    "    .Define(\"Knerec_5\", \"Knerec[5]\")\n",    "    .Define(\"KnerecSix_5\", \"KnerecSix[5] - 497.611\")\n",    "    .Define(\"MassPi01\", \"pi01Fit[5]\")\n",    "    .Define(\"MassPi02\", \"pi02Fit[5]\")\n",    "    .Define(\"rho_ch\", \"hypot(Kchrec[6] - ip[0], Kchrec[7] - ip[1])\")\n",    "    .Define(\"rho_ne\", \"hypot(Knerec[6] - ip[0], Knerec[7] - ip[1])\")\n",    "    .Define(\"z_ch\", \"Kchrec[8] - ip[2]\")\n",    "    .Define(\"z_ne\", \"Knerec[8] - Bz\")\n",    "    .Define(\"rho_fid_omega\", \"hypot(Kchrec[6] - Knerec[6], Kchrec[7] - Knerec[7])\")\n",    "    .Define(\"z_fid_omega\", \"Kchrec[8] - Knerec[8]\")\n",    "    .Define(\"DeltatBoostTriFit\", \"KaonChTimeCMBoostTriFit - KaonNeTimeCMBoostTriFit\")\n",    "    .Filter(\"mctruth != -1\"))\n",    "df = (df\n",    "    .Define(\"Kchrec_5\", \"Kchrec[5]\")\n",    "    .Define(\"Knerec_5\", \"Knerec[5]\")\n",    "    .Define(\"KnerecSix_5\", \"KnerecSix[5] - 497.611\")\n",    "    .Define(\"MassPi01\", \"pi01Fit[5]\")\n",    "    .Define(\"MassPi02\", \"pi02Fit[5]\")\n",    "    .Define(\"rho_ch\", \"hypot(Kchrec[6] - ip[0], Kchrec[7] - ip[1])\")\n",    "    .Define(\"rho_ne\", \"hypot(Knerec[6] - ip[0], Knerec[7] - ip[1])\")\n",    "    .Define(\"z_ch\", \"Kchrec[8] - ip[2]\")\n",    "    .Define(\"z_ne\", \"Knerec[8] - Bz\")\n",    "    .Define(\"rho_fid_omega\", \"hypot(Kchrec[6] - Knerec[6], Kchrec[7] - Knerec[7])\")\n",    "    .Define(\"z_fid_omega\", \"Kchrec[8] - Knerec[8]\")\n",    "    .Define(\"DeltatBoostTriFit\", \"KaonChTimeCMBoostTriFit - KaonNeTimeCMBoostTriFit\")\n",    "    .Filter(\"mctruth != -1 && mctruth != 0 \"))"   ]  },  {   "cell_type": "code",   "execution_count": 46,   "id": "3a4bf563-a426-4069-8cd7-4e163765585f",   "metadata": {},   "outputs": [    {     "name": "stdout",     "output_type": "stream",     "text": [      "Counts total: 53654762,\n",      "Counts preselection: 38868728,\n",      "Counts selection: 38868728\n",      "Efficiency total: 72.44%,\n",      "Efficiency preselection: 72.44%,\n",      "Efficiency selection: 100.00%\n",      "Error 300: 90.54% (90.54%) (48577718)\n",      "Error 301: 75.22% (83.09%) (40361042)\n",      "Error 303: 74.31% (98.79%) (39871112)\n",      "Error 307: 72.44% (97.49%) (38868728)\n",      "Error 308: 72.44% (100.00%) (38868728)\n"     ]    }   ],   "source": [    "counts = []\n",    "\n",    "counts.append(df_3pi0.Count())\n",    "counts.append(df_3pi0.Filter(\"mctruth == 4 || mctruth == 0\").Count())\n",    "counts.append(df_3pi0.Filter(\"mctruth == 4\").Count())\n",    "\n",    "errors = [300, 301, 303, 307, 308]\n",    "counts_errors = []\n",    "combined_error = \"\"\n",    "\n",    "for error in errors:\n",    "    combined_error += f\" && errorcode != {error}\" if len(combined_error) > 0 else f\"errorcode != {error}\"\n",    "    counts_errors.append(df_3pi0.Filter(combined_error).Count())\n",    "\n",    "all_counts = counts + counts_errors\n",    "\n",    "ROOT.RDF.RunGraphs(all_counts)\n",    "\n",    "for i, val in enumerate(counts):\n",    "    counts[i] = val.GetValue()\n",    "\n",    "error_eff = []\n",    "rel_error_eff = []\n",    "\n",    "for i, val in enumerate(counts_errors):\n",    "    counts_errors[i] = val.GetValue()\n",    "    eff = counts_errors[i] / counts[0] if counts[0] > 0 else 1.0\n",    "    rel_eff = counts_errors[i] / counts_errors[i-1] if i > 0 else eff\n",    "    error_eff.append(eff)\n",    "    rel_error_eff.append(rel_eff)\n",    "\n",    "efficiencies = [0, 0, 0]\n",    "efficiencies[0] = counts[1] / counts[0] if counts[0] > 0 else 1.0\n",    "efficiencies[1] = counts[2] / counts[1] if counts[1] > 0 else 1.0\n",    "efficiencies[2] = counts[2] / counts[0] if counts[0] > 0 else 1.0\n",    "\n",    "print(f\"Counts total: {counts[0]},\\nCounts preselection: {counts[1]},\\nCounts selection: {counts[2]}\")\n",    "print(f\"Efficiency total: {efficiencies[2]*100:.2f}%,\\nEfficiency preselection: {efficiencies[0]*100:.2f}%,\\nEfficiency selection: {efficiencies[1]*100:.2f}%\")\n",    "\n",    "for i, eff in enumerate(error_eff):\n",    "    print(f\"Error {errors[i]}: {eff*100:.2f}% ({rel_error_eff[i]*100:.2f}%) ({counts_errors[i]})\")"   ]  },  {   "cell_type": "code",   "execution_count": 47,   "id": "622da22f-a176-4602-9ee8-3b673987c150",   "metadata": {},   "outputs": [    {     "data": {      "text/plain": [       "1"      ]     },     "execution_count": 47,     "metadata": {},     "output_type": "execute_result"    }   ],   "source": [    "histos = {}\n",    "\n",    "for mctruth, chann in channName.items():\n",    "    if mctruth > 0 and mctruth < 8:\n",    "        hist_list = []\n",    "        hist_list.append((df.Filter(f\"mctruth == {mctruth}\")\n",    "                           .Histo1D((\"h_rho_ch\", \";#rho_{ch} [cm];Counts\", 201, 0, 12), \"rho_ch\")))\n",    "        hist_list.append((df.Filter(f\"mctruth == {mctruth}\")\n",    "                           .Histo1D((\"h_z_ch\", \";z_{ch} - z_{IP} [cm];Counts\", 201, -6, 6), \"z_ch\")))\n",    "\n",    "        histos[chann] = hist_list\n",    "\n",    "handles = [h for hist_list in histos.values() for h in hist_list]\n",    "        \n",    "ROOT.RDF.RunGraphs(handles)"   ]  },  {   "cell_type": "code",   "execution_count": 48,   "id": "36355b17-042f-4928-9577-fa11d72a0e58",   "metadata": {},   "outputs": [],   "source": [    "highest_chann = get_highest_channels(histos)"   ]  },  {   "cell_type": "code",   "execution_count": 49,   "id": "7fd5d2b4-5009-4309-aad4-0c07cc3fce9f",   "metadata": {},   "outputs": [    {     "data": {      "text/html": [       "\n",       "\n",       "<div id=\"root_plot_1791145876855\" style=\"width: 800px; height: 400px; position: relative\">\n",       "</div>\n",       "\n",       "<script>\n",       "\n",       "function display_root_plot_1791145876855(Core) {\n",       "   let obj = Core.parse({\"_typename\":\"TCanvasWebSnapshot\",\"fUniqueID\":0,\"fBits\":0,\"fObjectID\":\"\",\"fOption\":\"\",\"fKind\":3,\"fSnapshot\":{\"_typename\":\"TCanvas\",\"fUniqueID\":0,\"fBits\":3342344,\"fLin