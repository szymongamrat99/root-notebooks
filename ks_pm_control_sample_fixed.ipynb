, chann_dict) in enumerate(basic_hist[var].items()):\n",    "        \n",    "        # Obliczenie indeksu podokna w TCanvas (ROOT numeruje od 1: wiersz po wierszu)\n",    "        pad_idx = row_idx * n_cols + col_idx + 1\n",    "        canva.cd(pad_idx)\n",    "        \n",    "        hs = ROOT.THStack(f\"hs_{var}_{mode_name}\", f\"{mode_name.capitalize()} mode;{x_title};Counts\")\n",    "        leg = ROOT.TLegend(0.45, 0.65, 0.88, 0.88)\n",    "        leg.SetBorderSize(0)\n",    "        leg.SetFillStyle(0)\n",    "        \n",    "        data_hist = None\n",    "\n",    "        for chann_key, hist in chann_dict.items():\n",    "            h = hist.GetValue() if hasattr(hist, \"GetValue\") else hist\n",    "            color = channColor.get(chann_key, ROOT.kBlack)\n",    "            title = channTitle.get(chann_key, chann_key)\n",    "            \n",    "            if chann_key == \"Data\":\n",    "                # Styl dla danych eksperymentalnych (PE1)\n",    "                h.SetMarkerStyle(20)\n",    "                h.SetMarkerSize(0.8)\n",    "                h.SetMarkerColor(color)\n",    "                h.SetLineColor(color)\n",    "                h.SetLineWidth(2)\n",    "                \n",    "                data_hist = h\n",    "                leg.AddEntry(h, title, \"pe\")\n",    "            else:\n",    "                # Styl dla MC\n",    "                h.SetLineColor(color)\n",    "                h.SetLineWidth(2)\n",    "                \n",    "                hs.Add(h)\n",    "                leg.AddEntry(h, title, \"l\")\n",    "\n",    "        # 1. Rysujemy stack z MC\n",    "        hs.Draw(\"nostack hist\")\n",    "        \n",    "        # 2. Rysujemy Dane oraz dopasowujemy skalę Y\n",    "        if data_hist:\n",    "            data_hist.Draw(\"E1 P SAME\")\n",    "            max_y_val = max(hs.GetMaximum(), data_hist.GetMaximum()) * 0.6\n",    "            hs.SetMaximum(max_y_val)\n",    "\n",    "        leg.Draw()\n",    "\n",    "        stacks.append(hs)\n",    "        legends.append(leg)\n",    "\n",    "# Zapobieganie usunięciu obiektów z pamięci przez Python Garbage Collector\n",    "canva._stacks = stacks\n",    "canva._legends = legends\n",    "\n",    "canva.Draw()"   ]  },  {   "cell_type": "markdown",   "id": "2aa2fb8f-5f10-4d62-b42e-d40c39611c44",   "metadata": {},   "source": [    "## Conditional probability: KL->3pi0 if KS->pi+pi- (change of lookup to channel level)"   ]  },  {   "cell_type": "code",   "execution_count": 26,   "id": "d0e7cf98-e2a2-4931-9954-947fb72c9ab8",   "metadata": {},   "outputs": [],   "source": [    "df_tag_channel = {}\n",    "total_counts_tagged_channels = {}\n",    "total_counts_tagged_channels_000 = {}\n",    "total_counts_tagged_channels_non000 = {}\n",    "\n",    "for mctruth, chann in channName.items():\n",    "    if chann == 'Data':\n",    "        df_tag_channel[chann] = df_data.Filter(tag_condition)\n",    "        total_counts_tagged_channels[chann] = df_tag_channel[chann].Count()\n",    "        total_counts_tagged_channels_000[chann] = df_tag_channel[chann].Filter(\"has000\").Count()\n",    "        total_counts_tagged_channels_non000[chann] = df_tag_channel[chann].Filter(\"!has000\").Count()\n",    "    elif chann != 'MC sum':\n",    "        df_tag_channel[chann] = df.Filter(f\"mctruth == {mctruth} && ({tag_condition})\")\n",    "        total_counts_tagged_channels[chann] = df_tag_channel[chann].Count()\n",    "        total_counts_tagged_channels_000[chann] = df_tag_channel[chann].Filter(\"has000\").Count()\n",    "        total_counts_tagged_channels_non000[chann] = df_tag_channel[chann].Filter(\"!has000\").Count()\n",    "\n",    "ROOT.RDF.RunGraphs(list(total_counts_tagged_channels.values()))\n",    "\n",    "total_counts_tagged_channels = {key: int(val.GetValue() * scaling_factor) if key != 'Data' else int(val.GetValue()) for key, val in total_counts_tagged_channels.items()}\n",    "total_counts_tagged_channels_000 = {key: int(val.GetValue() * scaling_factor) if key != 'Data' else int(val.GetValue()) for key, val in total_counts_tagged_channels_000.items()}\n",    "total_counts_tagged_channels_non000 = {key: int(val.GetValue() * scaling_factor) if key != 'Data' else int(val.GetValue()) for key, val in total_counts_tagged_channels_non000.items()}\n"   ]  },  {   "cell_type": "code",   "execution_count": 27,   "id": "059bd134-076c-4b78-b1fc-2100afe3f5bc",   "metadata": {},   "outputs": [    {     "name": "stdout",     "output_type": "stream",     "text": [      "Total counts of channels after tagging:\n",      "Counts Data: 12461478\n",      "Counts Signal: 1173\n",      "Counts Regeneration: 3227\n",      "Counts Omega: 5656\n",      "Counts 3pi0: 11643319\n",      "Counts Semileptonic: 19644\n",      "Counts Other: 1162791\n",      "Counts pi+pi-pi+pi-: 22\n",      "Counts MC sum: 0\n",      "--- Purity analysis (Total) ---\n",      "3pi0 counts: 11643319\n",      "Total MC counts: 12835832\n",      "Purity (3pi0 / Total MC): 90.7095%\n",      "Contamination (Background / Total MC): 9.2905%\n",      "\n",      "==================================================\n",      "\n",      "Total counts of channels after tagging (000):\n",      "Counts Data: 0\n",      "Counts Signal: 0\n",      "Counts Regeneration: 0\n",      "Counts Omega: 0\n",      "Counts 3pi0: 11643319\n",      "Counts Semileptonic: 0\n",      "Counts Other: 701859\n",      "Counts pi+pi-pi+pi-: 0\n",      "Counts MC sum: 0\n",      "--- Purity analysis (000) ---\n",      "3pi0 counts: 11643319\n",      "Total MC counts: 12345178\n",      "Purity (3pi0 / Total MC): 94.3147%\n",      "Contamination (Background / Total MC): 5.6853%\n",      "\n",      "==================================================\n",      "\n",      "Total counts of channels after tagging (non 000):\n",      "Counts Data: 12461478\n",      "Counts Signal: 1173\n",      "Counts Regeneration: 3227\n",      "Counts Omega: 5656\n",      "Counts 3pi0: 0\n",      "Counts Semileptonic: 19644\n",      "Counts Other: 460932\n",      "Counts pi+pi-pi+pi-: 22\n",      "Counts MC sum: 0\n",      "--- Purity analysis (non 000) ---\n",      "3pi0 counts: 0\n",      "Total MC counts: 490654\n",      "Purity (3pi0 / Total MC): 0.0000%\n",      "Contamination (Background / Total MC): 100.0000%\n"     ]    }   ],   "source": [    "def print_purity(counts_dict, label=\"\"):\n",    "    # Obliczamy sumę zliczeń wszystkich kanałów MC (pomijamy 'Data' oraz 'MC sum')\n",    "    total_mc = sum(\n",    "        count\n",    "        for ch, count in counts_dict.items()\n",    "        if ch not in [\"Data\", \"MC sum\"]\n",    "    )\n",    "\n",    "    count_3pi0 = counts_dict.get(\"3pi0\", 0)\n",    "\n",    "    if total_mc > 0:\n",    "        purity = (count_3pi0 / total_mc) * 100\n",    "        contamination = 100.0 - purity\n",    "        print(f\"--- Purity analysis {label} ---\")\n",    "        print(f\"3pi0 counts: {count_3pi0}\")\n",    "        print(f\"Total MC counts: {total_mc}\")\n",    "        print(f\"Purity (3pi0 / Total MC): {purity:.4f}%\")\n",    "        print(f\"Contamination (Background / Total MC): {contamination:.4f}%\")\n",    "    else:\n",    "        print(f\"--- Purity analysis {label} ---\")\n",    "        print(\"Total MC counts is 0 - cannot calculate purity.\")\n",    "\n",    "\n",    "# --- 1. Total counts after tagging ---\n",    "print(\"Total counts of channels after tagging:\")\n",    "for chann in channName.values():\n",    "    print(f\"Counts {chann}: {total_counts_tagged_channels.get(chann, 0)}\")\n",    "\n",    "print_purity(total_counts_tagged_channels, \"(Total)\")\n",    "print(\"\\n\" + \"=\" * 50 + \"\\n\")\n",    "\n",    "\n",    "# --- 2. Total counts after tagging (000) ---\n",    "print(\"Total counts of channels after tagging (000):\")\n",    "for chann in channName.values():\n",    "    print(f\"Counts {chann}: {total_counts_tagged_channels_000.get(chann, 0)}\")\n",    "\n",    "print_purity(total_counts_tagged_channels_000, \"(000)\")\n",    "print(\"\\n\" + \"=\" * 50 + \"\\n\")\n",    "\n",    "\n",    "# --- 3. Total counts after tagging (non 000) ---\n",    "print(\"Total counts of channels after tagging (non 000):\")\n",    "for chann in channName.values():\n",    "    print(f\"Counts {chann}: {total_counts_tagged_channels_non000.get(chann, 0)}\")\n",    "\n",    "print_purity(total_counts_tagged_channels_non000, \"(non 000)\")"   ]  },  {   "cell_type": "code",   "execution_count": 28,   "id": "d501cf6b-6a0c-42b2-9a95-6f235ece2f5e",   "metadata": {},   "outputs": [],   "source": [    "variables = [\"Chi2SignalKinFit\", \"Kchrec_5\", \"Qmiss\"]\n",    "var_title = [\"#chi^{2}_{fit, +-00} [-]\", \n",    "             \"m^{inv}_{+-} [MeV/c^{2}]\",\n",    "             \"Q_{miss} [MeV]\"]"   ]  },  {   "cell_type": "code",   "execution_count": 29,   "id": "f67568df-2e35-4140-8dec-09a40ec47567",   "metadata": {},   "outputs": [],   "source": [    "import ROOT\n",    "\n",    "# Flaga sterująca: True -> odejmij tło !has00 od Danych i bierz tylko has00 dla MC\n",    "SUBTRACT_NON_00 = False\n",    "\n",    "basic_hist = {}\n",    "modes = {\n",    "    \"full\": [\n",    "        [501, 0, 1000],\n",    "        [501, 280, 600],\n",    "        [501, 0, 350]\n",    "    ],\n",    "    \"zoom\": [\n",    "        [50, 0, 100],\n",    "        [251, 420, 530],\n",    "        [251, 0, 50]\n",    "    ],\n",    "}\n",    "\n",    "# Słownik na pomocnicze wskaźniki histogramów !has00 dla Danych (używany gdy SUBTRACT_NON_00 = True)\n",    "data_non_00_ptrs = {}\n",    "\n",    "for idx, (var, x_title) in enumerate(zip(variables, var_title)):\n",    "    mode_dict = {}\n",    "\n",    "    for mode, pars in modes.items():\n",    "\n",    "        hist_dict = {}\n",    "        for chann in channName.values():\n",    "            if chann == \"MC sum\":\n",    "                continue\n",    "\n",    "            h_title = f\"hist_{var}_{mode}_{chann}\"\n",    "            hist_title_list = f\";{x_title};Counts\"\n",    "\n",    "            # Przypisujemy pomocniczy dataframe dla danego kanału\n",    "            df_aux = df_tag_channel[chann]\n",    "\n",    "            if chann == \"Data\":\n",    "                # Dla Danych tworzymy standardowy histogram\n",    "                hist_dict[chann] = df_aux.Histo1D(\n",    "                    (h_title, hist_title_list, *pars[idx]), var\n",    "                )\n",    "\n",    "                # Jeśli odejmujemy !has00, tworzymy dodatkowy histogram filtracyjny dla Data\n",    "                if SUBTRACT_NON_00:\n",    "                    h_title_non_00 = f\"hist_{var}_{mode}_{chann}_non_000\"\n",    "                    df_non_00_aux = df_aux.Filter(\"!has000\")\n",    "                    data_non_00_ptrs[(var, mode)] = df_non_00_aux.Histo1D(\n",    "                        (h_title_non_00, hist_title_list, *pars[idx]), var\n",    "                    )\n",    "            else:\n",    "                # Dla MC: jeśli włączone odejmowanie, bierzemy tylko zdarzenia z has00\n",    "                if SUBTRACT_NON_00:\n",    "                    df_aux = df_aux.Filter(\"has000\")\n",    "\n",    "                hist_dict[chann] = df_aux.Histo1D(\n",    "                    (h_title, hist_title_list, *pars[idx]), var\n",    "                )\n",    "\n",    "        mode_dict[mode] = hist_dict\n",    "\n",    "    basic_hist[var] = mode_dict\n",    "\n",    "# 2. Ewaluacja wszystkich grafów na raz (Lazy Evaluation)\n",    "all_ptrs = [\n",    "    h_ptr\n",    "    for mode_d in basic_hist.values()\n",    "    for ch_d in mode_d.values()\n",    "    for h_ptr in ch_d.values()\n",    "]\n",    "if SUBTRACT_NON_00:\n",    "    all_ptrs.extend(data_non_00_ptrs.values())\n",    "\n",    "ROOT.RDF.RunGraphs(all_ptrs)\n",    "\n",    "# 3. Odejmowanie tła !has00 od Danych, skalowanie MC i tworzenie \"MC sum\"\n",    "for var, mode_d in basic_hist.items():\n",    "    for mode, ch_d in mode_d.items():\n",    "\n",    "        # Odejmujemy histogram !has00 od histogramu Danych\n",    "        if SUBTRACT_NON_00 and \"Data\" in ch_d:\n",    "            h_data = ch_d[\"Data\"].GetPtr()\n",    "            h_data_non_00 = data_non_00_ptrs[(var, mode)].GetPtr()\n",    "            h_data.Add(h_data_non_00, -1.0)\n",    "\n",    "        # Skalowanie kanałów MC (wszystko poza 'Data')\n",    "        for chann, h_ptr in ch_d.items():\n",    "            if chann != \"Data\":\n",    "                h_ptr.Scale(scaling_factor)\n",    "\n",    "        # Tworzenie sumy MC\n",    "        mc_channels = [ch for ch in ch_d.keys() if ch != \"Data\"]\n",    "\n",    "        if mc_channels:\n",    "            h_mc_sum = ch_d[mc_channels[0]].Clone(f\"hist_{var}_{mode}_MC_sum\")\n",    "            for ch in mc_channels[1:]:\n",    "                h_mc_sum.Add(ch_d[ch].GetPtr(), 1.0)\n",    "\n",    "            # Zapisujemy wygenerowaną sumę w słowniku\n",    "            ch_d[\"MC sum\"] = h_mc_sum"   ]  },  {   "cell_type": "code",   "execution_count": 30,   "id": "61e753a6-f0d5-43a9-b9d7-ec1ca8a7e4df",   "metadata": {},   "outputs": [    {     "data": {      "text/html": [       "\n",       "\n",       "<div id=\"root_plot_1790808401303\" style=\"width: 2000px; height: 1000px; position: relative\">\n",       "</div>\n",       "\n",       "<script>\n",       "\n",       "function display_root_plot_1790808401303(Core) {\n",       "   let obj = Core.parse({\"_typename\":\"TCanvasWebSnapshot\",\"fUniqueID\":0,\"fBits\":0,\"fObjectID\":\"\",\"fOption\":\"\",\"fKind\":3,\"fSnapshot\":{\"_typename\":\"TCanvas\",\"fUniqueID\":0,\"fBits\":3342344,\"fLineColor\":1,\"fLineStyle\":1,\"fLineWidth\":2,\"fFillColor\":0,\"fFillStyle\":1001,\"fLeftMargin\":0.15,\"fRightMargin\":0.15,\"fBottomMargin\":0.15,\"fTopMargin\":0.1,\"fXfile\":2,\"fYfile\":2,\"fAfile\":1,\"fXstat\":0.99,\"fYstat\":0.99,\"fAstat\":2,\"fFrameFillCol