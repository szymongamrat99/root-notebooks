    "# ----------------------------------------------\n",
    "\n",
    "# Drawing full and zoomed stacked histograms\n",
    "canva = ROOT.TCanvas(\"canva\", \"\", 1000, 500)\n",
    "canva.Divide(2, 1)\n",
