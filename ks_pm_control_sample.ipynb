    "variables = [\"Chi2SignalKinFit\", \"Knerec_5\", \"KnerecSix_5\", \"MassPi01\", \"MassPi02\", \"Kchrec_5\"]\n",
    "var_title = [\"#chi^{2}_{fit, +-00} [-]\", \n",
