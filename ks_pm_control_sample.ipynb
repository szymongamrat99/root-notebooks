    "df_tag_channel = {}\n",
    "total_counts_tagged_channels = {}\n",
    "total_counts_tagged_channels_000 = {}\n",
    "total_counts_tagged_channels_non000 = {}\n",
    "\n",
    "for mctruth, chann in channName.items():\n",
    "    if chann == 'Data':\n",
    "        df_tag_channel[chann] = df_data.Filter(tag_condition)\n",
    "        total_counts_tagged_channels[chann] = df_tag_channel[chann].Count()\n",
    "        total_counts_tagged_channels_000[chann] = df_tag_channel[chann].Filter(\"has000\").Count()\n",
    "        total_counts_tagged_channels_non000[chann] = df_tag_channel[chann].Filter(\"!has000\").Count()\n",
    "    elif chann != 'MC sum':\n",
    "        df_tag_channel[chann] = df.Filter(f\"mctruth == {mctruth} && ({tag_condition})\")\n",
    "        total_counts_tagged_channels[chann] = df_tag_channel[chann].Count()\n",
    "        total_counts_tagged_channels_000[chann] = df_tag_channel[chann].Filter(\"has000\").Count()\n",
    "        total_counts_tagged_channels_non000[chann] = df_tag_channel[chann].Filter(\"!has000\").Count()\n",
    "\n",
    "ROOT.RDF.RunGraphs(list(total_counts_tagged_channels.values()))\n",
    "\n",
    "total_counts_tagged_channels = {key: int(val.GetValue() * scaling_factor) if key != 'Data' else int(val.GetValue()) for key, val in total_counts_tagged_channels.items()}\n",
    "total_counts_tagged_channels_000 = {key: int(val.GetValue() * scaling_factor) if key != 'Data' else int(val.GetValue()) for key, val in total_counts_tagged_channels_000.items()}\n",
    "total_counts_tagged_channels_non000 = {key: int(val.GetValue() * scaling_factor) if key != 'Data' else int(val.GetValue()) for key, val in total_counts_tagged_channels_non000.items()}\n"
   ]
