   "source": [
    "\n",
    "# Pobierz wszystkie pliki pasujÄ…ce do wzorca\n",
    "all_files = glob.glob(\n",
    "    \"/workspace/root_files/kitt/ALL_PHYS_THREE_PI0_NoSmearing/*.root\"\n",
    ")\n",
    "all_files += glob.glob(\n",
    "    \"/workspace/root_files/kitt/ALL_PHYS2_THREE_PI0_NoSmearing/*.root\"\n",
    ")\n",
    "all_files += glob.glob(\n",
    "    \"/workspace/root_files/kitt/ALL_PHYS3_THREE_PI0_NoSmearing/*.root\"\n",
    ")\n",
    "\n",
    "data_files = []\n",
    "\n",
    "for i in range(1, 106, 1):\n",
    "    data_files += glob.glob(\n",
    "        f\"/workspace/root_files/hal/DATA_THREE_PI0_NoSmearing/dk0*_{i}.root\"\n",
    "    )\n",
    "\n",
    "def check_single_file(f):\n",
    "    \"\"\"Sprawdza pojedynczy plik na osobnym wÄ…tku.\"\"\"\n",
    "    try:\n",
    "        # kError ignoruje niepotrzebne ostrzeÅ¼enia w konsoli\n",
    "        ROOT.gErrorIgnoreLevel = ROOT.kError\n",
    "        tf = ROOT.TFile.Open(f, \"READ\")\n",
    "        if tf and not tf.IsZombie():\n",
    "            tree = tf.Get(\"h1\")\n",
    "            if tree and not tree.IsZombie():\n",
    "                tf.Close()\n",
    "                return f\n",
    "        if tf:\n",
    "            tf.Close()\n",
    "    except Exception:\n",
    "        pass\n",
    "    return None\n",
    "\n",
    "\n",
    "def get_valid_files_fast(file_list):\n",
    "    \"\"\"Sprawdza caÅ‚Ä… listÄ™ plikÃ³w rÃ³wnolegle na wielu rdzeniach CPU.\"\"\"\n",
    "    with concurrent.futures.ThreadPoolExecutor(max_workers=64) as executor:\n",
    "        results = list(executor.map(check_single_file, file_list))\n",
    "    # Zwraca tylko poprawne pliki\n",
    "    valid = [f for f in results if f is not None]\n",
    "    print(\n",
    "        f\"Przetestowano {len(file_list)} plikÃ³w. Poprawnych: {len(valid)}, Odrzuconych: {len(file_list) - len(valid)}\"\n",
    "    )\n",
    "    return valid\n",
    "\n",
    "\n",
    "# UÅ¼ycie (bÅ‚yskawiczne!):\n",
    "all_files = get_valid_files_fast(all_files)\n",
    "data_files = get_valid_files_fast(data_files)\n",
    "\n",
    "# Scaling factor\n",
    "lumi_data = 408608.49375\n",
    "lumi_mc = 745800.1127\n",
    "scaling_factor = lumi_data / lumi_mc\n",
    "print(f\"Lumi factor: {scaling_factor:.4f}\")\n",
    "\n",
    "# PrzekaÅ¼ czystÄ… listÄ™ plikÃ³w bezpoÅ›rednio do RDataFrame\n",
    "df = ROOT.RDataFrame(\"h1\", all_files)\n",
    "df_data = ROOT.RDataFrame(\"h1\", data_files)\n",
    "df_3pi0 = df.Filter(\"mcflag == 1 && (mctruth == 4 || mctruth == 0 || mctruth == -1)\")\n",
    "df_data = (df_data\n",
    "    .Define(\"Kchrec_5\", \"Kchrec[5]\")\n",
    "    .Define(\"Knerec_5\", \"Knerec[5]\")\n",
    "    .Define(\"KnerecSix_5\", \"KnerecSix[5] - 497.611\")\n",
    "    .Define(\"MassPi01\", \"pi01Fit[5]\")\n",
    "    .Define(\"MassPi02\", \"pi02Fit[5]\")\n",
    "    .Define(\"rho_ch\", \"hypot(Kchrec[6] - ip[0], Kchrec[7] - ip[1])\")\n",
    "    .Define(\"rho_ne\", \"hypot(Knerec[6] - ip[0], Knerec[7] - ip[1])\")\n",
    "    .Define(\"z_ch\", \"Kchrec[8] - ip[2]\")\n",
    "    .Define(\"z_ne\", \"Knerec[8] - Bz\")\n",
    "    .Define(\"rho_fid_omega\", \"hypot(Kchrec[6] - Knerec[6], Kchrec[7] - Knerec[7])\")\n",
    "    .Define(\"z_fid_omega\", \"Kchrec[8] - Knerec[8]\")\n",
    "    .Define(\"DeltatBoostTriFit\", \"KaonChTimeCMBoostTriFit - KaonNeTimeCMBoostTriFit\")\n",
    "    .Filter(\"mctruth != -1\"))\n",
    "df = (df\n",
    "    .Define(\"Kchrec_5\", \"Kchrec[5]\")\n",
    "    .Define(\"Knerec_5\", \"Knerec[5]\")\n",
    "    .Define(\"KnerecSix_5\", \"KnerecSix[5] - 497.611\")\n",
    "    .Define(\"MassPi01\", \"pi01Fit[5]\")\n",
    "    .Define(\"MassPi02\", \"pi02Fit[5]\")\n",
    "    .Define(\"rho_ch\", \"hypot(Kchrec[6] - ip[0], Kchrec[7] - ip[1])\")\n",
    "    .Define(\"rho_ne\", \"hypot(Knerec[6] - ip[0], Knerec[7] - ip[1])\")\n",
    "    .Define(\"z_ch\", \"Kchrec[8] - ip[2]\")\n",
    "    .Define(\"z_ne\", \"Knerec[8] - Bz\")\n",
    "    .Define(\"rho_fid_omega\", \"hypot(Kchrec[6] - Knerec[6], Kchrec[7] - Knerec[7])\")\n",
    "    .Define(\"z_fid_omega\", \"Kchrec[8] - Knerec[8]\")\n",
    "    .Define(\"DeltatBoostTriFit\", \"KaonChTimeCMBoostTriFit - KaonNeTimeCMBoostTriFit\")\n",
    "    .Filter(\"mctruth != -1 && mctruth != 0 \"))"
   ]
