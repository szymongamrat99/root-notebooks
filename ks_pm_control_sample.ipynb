   "source": [
    "cut_cond = \"true\"\n",
    "optimized_variable = \"bestErrorSixGamma\"\n",
    "var_title = \"#Delta_{6} [cm^{2}]\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "15e1a0a3-8dca-4208-aa6a-fe74f014d06f",
