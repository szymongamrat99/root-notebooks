    "    \n",
    "    hs = ROOT.THStack(f\"hs_{mode_name}\", f\"{mode_name.capitalize()} mode;{var_title};Counts\")\n",
    "    leg = ROOT.TLegend(0.45, 0.65, 0.88, 0.88)\n",
    "    leg.SetBorderSize(0)\n",
    "    leg.SetFillStyle(0)\n",
    "    \n",
    "    data_hist = None\n",
    "\n",
    "    for h_idx, hist in enumerate(hist_list):\n",
    "        h = hist.GetValue() if hasattr(hist, \"GetValue\") else hist\n",
    "        color = colors[h_idx % len(colors)]\n",
    "        title = titles[h_idx % len(titles)]\n",
    "        \n",
    "        # Rozpoznajemy kanaÅ‚ danych po tytule lub indeksie (tutaj np. indeks 2 = \"Data\")\n",
    "        if title == \"Data\":\n",
    "            # Styl dla punktÃ³w eksperymentalnych (PE1)\n",
    "            h.SetMarkerStyle(20)       # PeÅ‚ne kropki\n",
    "            h.SetMarkerSize(0.8)       # Rozmiar punktÃ³w\n",
    "            h.SetMarkerColor(color)\n",
    "            h.SetLineColor(color)\n",
    "            h.SetLineWidth(2)\n",
    "            \n",
