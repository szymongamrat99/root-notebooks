   "source": [
    "tag_condition = \"!(rho_ne < 4.0 && abs(z_ne) < 2.0)\"\n",
    "\n",
    "cut_values = [rms * float(val) for val in np.arange(0, 5.0, 0.1)]\n",
    "\n",
    "pm_counts = []\n",
    "nonpm_counts = []\n",
    "\n",
    "for val in cut_values:\n",
    "    condition = f\"{optimized_variable}< {val}\"\n",
    "\n",
    "    pm_counts.append(df_CS_tag[\"000\"].Filter(f\"{condition} && {tag_condition}\").Count())\n",
    "    nonpm_counts.append(df_CS_tag[\"non000\"].Filter(f\"{condition} && {tag_condition}\").Count())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "38c820bb-bb8a-46f8-b1ef-78f6bc67e41f",
   "metadata": {},
